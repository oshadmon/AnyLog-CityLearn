
GITHUB_DIR=/path/to/EdgeFL

TRAINING_APPLICATION_DIR=edgefl/platform_components/data_handlers
MODULE_NAME=CityLearnDataHandler
MODULE_FILE=citylearn_data_handler.py

TMP_DIR=edgefl/tmp_dir/

# community_c (anylog-operator2)
# AnyLog node the REST queries go to
EXTERNAL_IP="172.23.160.85:32159"
# Operator holding this community's data (AnyLog TCP port)
EXTERNAL_TCP_IP_PORT="172.23.160.85:32158"

# Tables written by the CityLearn publisher (fl.enabled: true)
LOGICAL_DATABASE=mydb
TRAIN_TABLE=building_obs_train
TEST_TABLE=building_obs_test

SERVER_TYPE=node

# Model / training settings. Keep MODEL_SEED and HIDDEN_SIZE identical on every node.
MODEL_SEED=0
HIDDEN_SIZE=64
TRAIN_EPOCHS=30
BATCH_SIZE=64
LEARNING_RATE=0.001
# Rounds of history each training round uses (1 = only the current round)
TRAIN_HISTORY_ROUNDS=1
# Test rows scored by /inference: all, or a round number
INFERENCE_ROUND=all

FILE_WRITE_DESTINATION="edgefl/file_write"

EDGELAKE_DOCKER_RUNNING="True"
EDGELAKE_DOCKER_CONTAINER_NAME="anylog-operator2"
DOCKER_FILE_WRITE_DESTINATION="/app/file_write"
